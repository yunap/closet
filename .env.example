# Keep Claude as the default so existing behavior does not break.
AI_PROVIDER=anthropic

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_STYLIST_MODEL=claude-sonnet-4-6

# Required when AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_STYLIST_MODEL=gpt-4o-mini
