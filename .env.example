# Keep Claude as the default so existing behavior does not break.
AI_PROVIDER=anthropic

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_STYLIST_MODEL=claude-sonnet-4-6

# Required when AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_STYLIST_MODEL=gpt-4o-mini

# Experimental freeform cost path. The execution router depends on the bounded composer contract,
# so enable both together during an approved live comparison. Both default off.
# WARDROBE_FREEFORM_ATOMIC_MULTILOOK=true
# WARDROBE_FREEFORM_EXECUTION_ROUTER=true
# WARDROBE_FREEFORM_ADAPTIVE_VISUALS=true

# WARDROBE_PLAN_PREROUTE, WARDROBE_BROAD_PLAN_PREROUTE, WARDROBE_FOLLOWUP_PREROUTE,
# and WARDROBE_PLAN_COMPOSE no longer do anything — the legacy precompose stack and
# engine-mode plan composition they gated were deleted (spec 14, spec 21). Remove
# them from any local .env; setting them is a harmless no-op.
