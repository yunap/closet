# Keep Claude as the default so existing behavior does not break.
AI_PROVIDER=anthropic

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_STYLIST_MODEL=claude-sonnet-4-6

# Required when AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_STYLIST_MODEL=gpt-4o-mini

# REMOVED 2026-08-19 — the freeform architecture is now unconditional and these flags no longer
# exist. Setting any of them does nothing; there is no way to switch the old behaviour back on.
#   WARDROBE_FREEFORM_ATOMIC_MULTILOOK    bounded 2-5 look composition in one pass
#   WARDROBE_FREEFORM_EXECUTION_ROUTER    model-owned execution-profile routing
#   WARDROBE_FREEFORM_ADAPTIVE_VISUALS    adaptive image detail on the bounded path
#   WARDROBE_FREEFORM_COMPACT_ANSWERS     compact card/garment/advice/inventory profiles
#   WARDROBE_FREEFORM_BOUNDED_HISTORY     bounded conversation prose window
# Also removed, as abandoned experiments rather than shipped defaults:
#   WARDROBE_FREEFORM_DEFERRED_TOOLS      hid schema chars without touching the real cost driver
#   WARDROBE_FREEFORM_TIERED_DISCOVERY    principle inherited by batched discovery; see
#                                         docs/freeform-batched-discovery-spec.md

# WARDROBE_PLAN_PREROUTE, WARDROBE_BROAD_PLAN_PREROUTE, WARDROBE_FOLLOWUP_PREROUTE,
# and WARDROBE_PLAN_COMPOSE no longer do anything — the legacy precompose stack and
# engine-mode plan composition they gated were deleted (spec 14, spec 21). Remove
# them from any local .env; setting them is a harmless no-op.
